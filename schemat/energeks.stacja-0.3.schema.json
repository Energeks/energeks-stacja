{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energeks-stacje-api.energeks.workers.dev/schemat/energeks.stacja-0.3.schema.json",
  "title": "Dane konfiguracji stacji SN/nN, energeks.stacja/0.3",
  "description": "Dane konfiguracji z kreatora, generatora i API. Programy muszą ignorować pola, których nie znają (nowe pola mogą dojść w wersji 0.x).",
  "type": "object",
  "required": [
    "schemat_danych",
    "silnik",
    "kod",
    "nazwa",
    "linia",
    "parametry_wejsciowe",
    "dane",
    "wyposazenie",
    "liczby"
  ],
  "properties": {
    "schemat_danych": {
      "const": "energeks.stacja/0.3"
    },
    "wygenerowano": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generator": {
      "type": "string"
    },
    "silnik": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+"
    },
    "producent": {
      "type": "object",
      "properties": {
        "marka": {
          "type": "string"
        },
        "nazwa": {
          "type": "string"
        },
        "adres": {
          "type": "string"
        },
        "nip": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "tel": {
          "type": "string"
        },
        "www": {
          "type": "string"
        },
        "sklep": {
          "type": "string"
        }
      }
    },
    "kod": {
      "type": "string",
      "pattern": "^ENG-(?:[BEP](?:2x)?\\d{2,4}Z?-(?:6|10|15|20)[SGP](?:20|25)?-[LWPTV]+|F\\d{2,3}-(?:6|10|15|20)-PB)-\\d{2}(?:\\+\\d{2})?(?:-(?=[IKSRAPMQWXYCDNTZU])I?K?S?R?A?P?M?Q?W?X?Y?(?:C[02])?(?:D\\d{3,4})?(?:N(?:00|1|2|3))?(?:T[123])?(?:Z[123])?(?:U(?:5|69|8|10))?)?(?:-(?:TAURON|ENEA|ENERGA|PGE|STOEN|OSD))?$"
    },
    "nazwa": {
      "type": "string"
    },
    "linia": {
      "type": "string"
    },
    "wejscie": {
      "$ref": "energeks.stacja.wejscie-0.3.schema.json"
    },
    "postepowanie": {
      "type": [
        "string",
        "null"
      ]
    },
    "opcje_dodatkowe": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grupa": {
            "type": "string"
          },
          "wartosc": {
            "type": "string"
          }
        }
      }
    },
    "parametry_wejsciowe": {
      "type": "object",
      "required": [
        "linia",
        "moc",
        "liczbaTrafo",
        "kV",
        "trafoTyp",
        "odplywy",
        "telemechanika",
        "osd",
        "przejecieOSD"
      ],
      "properties": {
        "linia": {
          "enum": [
            "B",
            "E",
            "F",
            "P"
          ],
          "description": "B stacja odbiorcza kontenerowa, E stacja dla e-mobilności, F stacja słupowa, P stacja dla fotowoltaiki (od 0.2)"
        },
        "moc": {
          "type": "integer",
          "minimum": 25,
          "maximum": 2500,
          "description": "moc transformatora w kVA (od 0.3 dowolna w zakresie linii; poza typoszeregiem transformator na zamówienie)"
        },
        "liczbaTrafo": {
          "enum": [
            1,
            2
          ]
        },
        "kV": {
          "enum": [
            6,
            10,
            15,
            20
          ],
          "description": "napięcie sieci SN w kV; aparatura 12 kV przy 6 i 10 kV, 24 kV przy 15 i 20 kV"
        },
        "trafoTyp": {
          "enum": [
            "olejowy",
            "suchy"
          ]
        },
        "izolacja": {
          "enum": [
            "s",
            "g",
            "p"
          ],
          "description": "s stało-powietrzna, g gazowa bez fluorowanych gazów cieplarnianych, p powietrzna; zawsze bez F-gazów (rozporządzenie (UE) 2024/573)"
        },
        "polaL": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "poleL": {
          "enum": [
            "L",
            "W"
          ]
        },
        "pomiar": {
          "enum": [
            "SN",
            "nN",
            "AMI",
            "brak"
          ]
        },
        "poleT": {
          "enum": [
            "R",
            "W"
          ],
          "description": "R rozłącznik z bezpiecznikami, W wyłącznik"
        },
        "odplywy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "rezerwaOdp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "odplywWlk": {
          "enum": [
            "NH00",
            "NH1",
            "NH2",
            "NH3"
          ]
        },
        "obsluga": {
          "enum": [
            "wewnetrzna",
            "zewnetrzna"
          ]
        },
        "obudowaSzer": {
          "enum": [
            2550,
            2960,
            null
          ]
        },
        "rei120": {
          "type": "boolean"
        },
        "agregat": {
          "type": "boolean"
        },
        "ppoz": {
          "type": "boolean"
        },
        "analizator": {
          "type": "boolean"
        },
        "kompJalowy": {
          "type": "boolean"
        },
        "zaciski": {
          "enum": [
            "TOC-1",
            "TOC-2",
            "MK 5",
            "brak"
          ]
        },
        "mocDocelowa": {
          "type": [
            "integer",
            "null"
          ]
        },
        "telemechanika": {
          "enum": [
            "brak",
            "przygotowanie",
            "FPI",
            "sterowanie"
          ]
        },
        "osd": {
          "enum": [
            "brak",
            "PGE",
            "Tauron",
            "Enea",
            "Energa",
            "Stoen"
          ]
        },
        "przejecieOSD": {
          "type": "boolean"
        },
        "auto": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "blokady": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "rezerwaMin": {
          "type": "integer"
        },
        "rezerwaMax": {
          "type": "integer"
        },
        "zaciskiMozliwe": {
          "type": "boolean"
        },
        "unn": {
          "enum": [
            0.4,
            0.5,
            0.69,
            0.8,
            1
          ]
        },
        "ikSN": {
          "enum": [
            16,
            20,
            25
          ],
          "description": "prąd zwarciowy sieci SN w kA (1 s); wybór przy sieci 6 i 10 kV (domyślnie 20), przy 15 i 20 kV 16 kA, w sieci Stoen 20 kA; w kodzie liczba po izolacji, gdy inna niż 16"
        },
        "aparatNN": {
          "enum": [
            "R",
            "W"
          ],
          "description": "aparat główny nN: R rozłącznik, W wyłącznik z wyzwalaczem nadprądowym (opcja W w kodzie, do 630 kVA; powyżej 630 kVA zawsze wyłącznik)"
        },
        "ups": {
          "type": "boolean"
        },
        "szr": {
          "enum": [
            "brak",
            "nN-agregat",
            "nN-sprzeglo",
            "SN"
          ]
        },
        "wnetrzowa": {
          "type": "boolean"
        },
        "mocSpoza": {
          "type": "boolean"
        }
      },
      "description": "parametry po normalizacji przez silnik: jak wejście, plus pomiar AMI (stacja przekazywana OSD), zaciski MK 5 (moc docelowa od 800 kVA), pola auto i blokady"
    },
    "dane": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parametr": {
            "type": "string"
          },
          "wartosc": {
            "type": "string"
          }
        }
      }
    },
    "parametry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grupa": {
            "type": "string"
          },
          "wiersze": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "parametr": {
                  "type": "string"
                },
                "wartosc": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "wyposazenie": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sekcja",
          "pozycje"
        ],
        "properties": {
          "sekcja": {
            "type": "string"
          },
          "pozycje": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nazwa": {
                  "type": "string"
                },
                "opis": {
                  "type": "string"
                },
                "dobierane_do_mocy": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "zalezne_od_mocy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parametr": {
            "type": "string"
          },
          "wartosc": {
            "type": "string"
          }
        }
      }
    },
    "liczby": {
      "type": "object",
      "description": "prądy w A, prądy zwarciowe w kA, przekroje w mm2, misa w l, moce w kVA",
      "properties": {
        "InSN": {
          "type": "number"
        },
        "InNN": {
          "type": "number"
        },
        "IkObl": {
          "type": "number"
        },
        "ipObl": {
          "type": "number"
        },
        "Icw": {
          "type": "number"
        },
        "Ipk": {
          "type": "number"
        },
        "wkl": {
          "type": [
            "number",
            "null"
          ]
        },
        "ctSN": {
          "type": "number"
        },
        "ctNN": {
          "type": "number"
        },
        "aparatA": {
          "type": "number"
        },
        "kabel": {
          "type": [
            "object",
            "null"
          ],
          "description": "połączenie transformator nN: n kabli na fazę o przekroju s mm2; null przy połączeniu szynowym"
        },
        "misaL": {
          "type": [
            "number",
            "null"
          ]
        },
        "przekrojSN": {
          "type": "number"
        },
        "Sd": {
          "type": "number"
        }
      }
    },
    "obudowa": {
      "type": [
        "object",
        "null"
      ],
      "description": "wymiary w mm, masy w t",
      "properties": {
        "typ": {
          "type": "string"
        },
        "nazwa": {
          "type": "string"
        },
        "L": {
          "type": "number"
        },
        "szer": {
          "type": "number"
        },
        "z": {
          "type": "object"
        },
        "masy": {
          "type": [
            "object",
            "null"
          ]
        },
        "pola": {
          "type": "array",
          "items": {
            "enum": [
              "L",
              "W",
              "P",
              "T",
              "V"
            ]
          }
        }
      }
    },
    "uwagi": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "poziom": {
            "enum": [
              "info",
              "uwaga",
              "blad"
            ]
          },
          "tekst": {
            "type": "string"
          }
        }
      }
    },
    "normy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "norma": {
            "type": "string"
          },
          "zakres": {
            "type": "string"
          }
        }
      }
    },
    "dokumenty": {
      "type": "object"
    },
    "certyfikaty_w_pakiecie": {
      "type": "array"
    },
    "braki": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "zastrzezenie": {
      "type": "string"
    },
    "projekt_techniczny": {
      "type": "object"
    },
    "cena": {
      "description": "Cena stacji (od wydania 0.2.1, kreator 1.9): netto w PLN z transportem w Polsce, z cennika Energeks, potwierdzana w ofercie. Tryb cena: cena_pln; widelki: od_pln i do_pln (stacja nietypowa albo pozycje szacowane); zapytanie: bez kwoty. Pole opcjonalne, dane bez niego są poprawne.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "tryb"
      ],
      "properties": {
        "tryb": {
          "enum": [
            "cena",
            "widelki",
            "zapytanie"
          ]
        },
        "cena_pln": {
          "type": "integer",
          "minimum": 1
        },
        "od_pln": {
          "type": "integer",
          "minimum": 1
        },
        "do_pln": {
          "type": "integer",
          "minimum": 1
        },
        "waluta": {
          "const": "PLN"
        },
        "netto": {
          "const": true
        },
        "transport_w_cenie": {
          "const": true
        },
        "cennik": {
          "type": [
            "string",
            "null"
          ]
        },
        "cennik_data": {
          "type": [
            "string",
            "null"
          ]
        },
        "opis": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}